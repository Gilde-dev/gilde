# Base URL of the Gilde API (including the /api prefix)
GILDE_API_URL=http://localhost:4100/api
# API key of the bot user (pnpm --filter @gilde/api apikey:create). Required.
GILDE_API_KEY=
# Slack (Socket Mode). Set both or neither.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Slack notifications (optional, needs SLACK_BOT_TOKEN). Run exactly one worker.
NOTIFICATIONS_ENABLED=
NOTIFICATION_SLACK_CHANNEL_ID=
GILDE_PUBLIC_URL=
# NOTIFICATION_KINDS=job.awaiting_review,job.parked,job.approval_needed,revision.waiting,feature.ready_to_close
