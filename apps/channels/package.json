{
  "name": "@gilde/channels",
  "version": "0.0.1",
  "description": "Runs the Gilde co-pilot in chat platforms (Slack first) with CopilotKit Channels.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@8.6.2",
  "scripts": {
    "dev": "tsx watch --include .env --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "oxlint --type-aware src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@ag-ui/mastra": "2.0.1",
    "@copilotkit/channels": "0.11.1",
    "@copilotkit/runtime": "1.80.0",
    "@mastra/client-js": "1.56.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.20.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
