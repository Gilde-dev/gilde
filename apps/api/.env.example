# Uncomment to use Postgres instead of the default SQLite (db.sqlite)
# DATABASE_URL=postgres://gilde:gilde@localhost:5432/gilde

# Shared secret for verifying GitHub webhook deliveries (X-Hub-Signature-256).
# Must match the secret configured on the GitHub webhook. Deliveries are rejected with 401 when unset.
GITHUB_WEBHOOK_SECRET=change-me

# Origin of the web UI (apps/web) allowed by CORS. Defaults to http://localhost:3000.
WEB_ORIGIN=http://localhost:3000

# Comma-separated GitHub Actions workflow names whose failure sends a job back to the agent (retry/park). Defaults to "CI".
GILDE_CI_WORKFLOWS=CI

# Comma-separated workflow names that act as gates: a failure flags the job as needing approval, never a retry. Defaults to "Gates".
GILDE_GATE_WORKFLOWS=Gates


# Token the reconcile sweep (every 5 min, POST /api/v1/reconcile) uses to recover job state when webhooks were missed.
# Fine-grained personal access token with read access to the repos: Pull requests: read, Actions: read, Metadata: read.
# Leave unset to disable the sweep.
GITHUB_TOKEN=

# File with the agent working instructions Gilde sends with every job (before the job payload).
# Relative paths resolve against the API working directory; an absolute path also works.
# Re-read when the file changes, no restart needed. Leave unset to send the payload only.
# Environment only: it cannot be set through the API.
AGENT_INSTRUCTIONS_PATH=../../docs/agent-instructions.md


# Secret used to sign login tokens (JWT, HS256). Required, at least 32 characters, when AUTH_ENABLED is true:
# the API refuses to start without it. Generate one with `openssl rand -base64 48`.
JWT_SECRET=

# How long a login token stays valid (e.g. 12h, 30m). Defaults to 12h.
JWT_EXPIRES_IN=12h

# Set to false to turn authentication off: the guard lets every request through and the API logs a warning at startup.
# Defaults to true.
AUTH_ENABLED=true

# Create a user (prompts for the password twice, minimum 12 characters):
#   pnpm --filter @gilde/api user:create --email <email> --name <name>

# Co-pilot (Mastra agent behind the web sidebar). Both are required, otherwise the co-pilot is disabled:
# the API still starts and /api/v1/mastra/* answers 503 (a warning is logged at startup).
# OpenAI API key. Only the API uses it; the browser never sees it.
OPENAI_API_KEY=
# Model id in Mastra model router format: openai/<model>. No default: pick one from the OpenAI models list
# (https://platform.openai.com/docs/models). Another provider later only needs a different value and its own key.
COPILOT_MODEL=openai/<model-id>
# Maximum tool-call steps per co-pilot run (default 30). On the last step tools are switched off so the agent ends with a message.
# COPILOT_MAX_STEPS=30
# Conversations are stored per user: in Postgres when DATABASE_URL is a postgres URL, otherwise in mastra.db in the API working directory.

# Maximum JSON request body for the co-pilot routes (/api/v1/mastra). AG-UI sends the whole conversation with every message,
# so long conversations need more than the default 100kb. Other routes keep the default limit. Defaults to 10mb.
# COPILOT_MAX_BODY=10mb
