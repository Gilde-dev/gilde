{
  "name": "@gilde/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@8.6.2",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --env-file .env",
    "dev": "nest start --watch --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node dist/main",
    "user:create": "nest build && node --env-file-if-exists=.env dist/cli/user-create.js",
    "user:mark-bot": "nest build && node --env-file-if-exists=.env dist/cli/user-mark-bot.js",
    "lesson:reject-retro-candidates": "nest build && node --env-file-if-exists=.env dist/cli/lesson-reject-retro-candidates.js",
    "apikey:create": "nest build && node --env-file-if-exists=.env dist/cli/apikey-create.js",
    "migration:generate": "node scripts/migration.mjs generate",
    "migration:run": "node scripts/migration.mjs run",
    "migration:revert": "node scripts/migration.mjs revert",
    "migration:check": "node scripts/migration.mjs check",
    "db:copy-sqlite-to-postgres": "nest build && node --env-file-if-exists=.env dist/cli/copy-sqlite-to-postgres.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@ag-ui/core": "1.0.3",
    "@ag-ui/mastra": "2.0.1",
    "@copilotkit/runtime": "1.80.0",
    "@mastra/core": "1.79.0",
    "@mastra/libsql": "1.27.0",
    "@mastra/memory": "1.39.0",
    "@mastra/nestjs": "0.2.38",
    "@mastra/pg": "1.32.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "argon2": "^0.45.1",
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
